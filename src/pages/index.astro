---
import '../styles/global.css';
import GraffitiWall from '../components/GraffitiWall.astro';
import CvLab from '../components/CvLab.astro';
import Terminal from '../components/Terminal.astro';
import SprayCan from '../components/SprayCan.astro';
import { me, services, projects, bugLog, tickerWords } from '../data/site.js';

const ticker = [...tickerWords, ...tickerWords];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#efeae0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0e13" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved theme before the first paint so the page never flashes.
      try { const t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch {}
    </script>
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{me.name} · Debugging, Open Source, OpenCV & ML</title>
    <meta name="description" content={`${me.name} (${me.handle}): ${me.tagline}`} />
    <meta property="og:title" content={`${me.name} · ${me.handle}`} />
    <meta property="og:description" content={me.tagline} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee&family=JetBrains+Mono:wght@400;700&family=Permanent+Marker&family=Rubik+Bubbles&family=Rubik+Spray+Paint&family=Rubik+Wet+Paint&family=Sedgwick+Ave&family=Sedgwick+Ave+Display&family=Space+Grotesk:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <GraffitiWall />
    <SprayCan />

    <div class="page">
      <!-- ============ NAV ============ -->
      <header class="nav">
        <div class="wrap nav-in">
          <a class="logo" href="#top">{me.handle}</a>
          <nav>
            <a href="#services">Services</a>
            <a href="#lab">CV Lab</a>
            <a href="#work">Work</a>
            <a href="#oss">Bug log</a>
          </nav>
          <div class="nav-actions">
            <button class="btn ghost small" data-open-terminal title="Open terminal (press `)">&gt;_</button>
            <button class="btn ghost small" data-theme-toggle title="Switch light / dark" aria-label="Switch light or dark theme"><span class="sun">☀</span><span class="moon">☾</span></button>
            <button class="btn ghost small" data-toggle-spray title="Spray on the wall">🎨 Spray</button>
            <a class="btn pink small" href="#contact">Hire me</a>
          </div>
        </div>
      </header>

      <!-- ============ HERO ============ -->
      <section class="hero wrap" id="top">
        <div class="hero-badges">
          <span class="sticker bg-lime" style="--t:-6deg">Debugger</span>
          <span class="sticker bg-pink" style="--t:4deg">Open source</span>
          <span class="sticker bg-cyan" style="--t:-3deg">OpenCV</span>
          <span class="sticker bg-yellow" style="--t:7deg">AI / ML</span>
        </div>

        <h1 class="hero-name">
          <span class="l1">Sushant</span>
          <span class="l2">Kumar</span>
        </h1>

        <div class="hero-row">
          <p class="hero-tag box">{me.tagline}</p>
          <div class="status box mono">
            <div><span class="dot"></span> status: <b>open for gigs</b></div>
            <div>stack: python · c/c++ · opencv · sklearn</div>
            <div>os: linux, obviously</div>
            <div class="blink">$ <span class="type" data-type="./hire --now"></span><i>▋</i></div>
          </div>
        </div>

        <div class="hero-cta">
          <a class="btn pink" href="#contact">File a bug for me →</a>
          <a class="btn" href="#work">See the wall</a>
          <a class="btn ghost" href={me.github} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </section>

      <!-- ============ TICKER ============ -->
      <div class="tape" aria-hidden="true">
        <div class="tape-track">
          {ticker.map((w) => <span>{w} ✦</span>)}
        </div>
      </div>

      <!-- ============ SERVICES ============ -->
      <section class="section" id="services">
        <div class="wrap">
          <div class="sec-head">
            <span class="sec-num">01</span>
            <h2>What I fix</h2>
            <p>Send me the broken thing. You get it working, plus a plain-English note on what went wrong.</p>
          </div>
          <div class="services">
            {services.map((s, i) => (
              <article class={`svc box bg-${s.color}`} style={`--t:${i % 2 ? 1.2 : -1.2}deg`}>
                <div class="svc-top mono"><span>{s.code}</span><span>OPEN</span></div>
                <h3>{s.title}</h3>
                <p>{s.blurb}</p>
                <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
                <a class="svc-link" href={`#contact`} data-service={s.title}>Request this →</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ CV LAB ============ -->
      <section class="section" id="lab">
        <div class="wrap">
          <div class="sec-head">
            <span class="sec-num">02</span>
            <h2>CV Lab</h2>
            <p>Live computer vision, running in your browser. Drop in a photo or use your webcam. Nothing gets uploaded.</p>
          </div>
          <CvLab />
        </div>
      </section>

      <!-- ============ WORK ============ -->
      <section class="section" id="work">
        <div class="wrap">
          <div class="sec-head">
            <span class="sec-num">03</span>
            <h2>The wall</h2>
            <p>Radar, signals, ML and games. Things I actually built.</p>
          </div>
          <div class="projects">
            {projects.map((p, i) => (
              <article class="proj box" style={`--t:${[-1.5, 1, -0.5, 1.8, -1, 0.6][i % 6]}deg`}>
                <div class={`proj-bar bg-${p.color}`}>
                  <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="mono">{p.kind}</span>
                </div>
                <h3>{p.name}</h3>
                <p>{p.text}</p>
                <div class="chips">{p.stack.map((t) => <span>{t}</span>)}</div>
                {p.link && <a class="proj-link" href={p.link} target="_blank" rel="noopener">Source ↗</a>}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============ OPEN SOURCE ============ -->
      <section class="section" id="oss">
        <div class="wrap">
          <div class="sec-head">
            <span class="sec-num">04</span>
            <h2>Bug log</h2>
            <p>Open-source work: bug reports with real repro steps, PR testing on real hardware, and fixes.</p>
          </div>
          <div class="oss">
            <ol class="log box">
              {bugLog.map((b) => (
                <li>
                  <span class={`log-tag t-${b.state}`}>{b.tag}</span>
                  <div>
                    <div class="mono log-where">{b.where}</div>
                    {b.link
                      ? <a href={b.link} target="_blank" rel="noopener">{b.title} ↗</a>
                      : <span>{b.title}</span>}
                  </div>
                  <span class="mono log-state">{b.state}</span>
                </li>
              ))}
            </ol>
            <div class="feed box">
              <div class="feed-head mono">
                <span>live · github.com/{me.handle}</span>
                <span class="dot"></span>
              </div>
              <div class="feed-list" data-gh-feed data-user={me.handle}>
                <p class="mono muted">fetching repos…</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ ABOUT ============ -->
      <section class="section about-sec">
        <div class="wrap about">
          <div class="about-card box">
            <span class="sticker bg-pink about-stk">whoami</span>
            <p>{me.about}</p>
          </div>
          <div class="about-stats">
            <div class="stat box bg-lime"><b>&lt;3%</b><span>heart-rate error vs ECG (RadarBed)</span></div>
            <div class="stat box bg-cyan"><b>Gold</b><span>hackathon medalist</span></div>
            <div class="stat box bg-yellow"><b>3 days</b><span>Unity from zero to a shipped game</span></div>
          </div>
        </div>
      </section>

      <!-- ============ CONTACT ============ -->
      <section class="section" id="contact">
        <div class="wrap">
          <div class="sec-head">
            <span class="sec-num">05</span>
            <h2>Open an issue</h2>
            <p>Tell me what's broken or what you want built. I'll reply with a plan and a quote.</p>
          </div>
          <div class="contact">
            <form class="issue box" data-issue-form data-email={me.email}>
              <div class="issue-head mono">
                <span class="dot"></span> New issue · {me.handle}/hire-me
              </div>
              <label>Title
                <input name="title" required placeholder="My script crashes on startup" />
              </label>
              <label>Label
                <select name="label">
                  {services.map((s) => <option>{s.title}</option>)}
                  <option>Something else</option>
                </select>
              </label>
              <label>What's happening?
                <textarea name="body" rows="6" required placeholder="What you expected, what happens instead, any error messages…"></textarea>
              </label>
              <label>Your email
                <input name="from" type="email" required placeholder="you@example.com" />
              </label>
              <button class="btn pink" type="submit">Submit new issue</button>
              <p class="mono muted small-print">Opens your email app with the issue filled in.</p>
            </form>

            <div class="links">
              <a class="link-card box bg-yellow" href={`mailto:${me.email}`}><b>Email</b><span>{me.email}</span></a>
              <a class="link-card box bg-lime" href={me.github} target="_blank" rel="noopener"><b>GitHub</b><span>@{me.handle}</span></a>
              <a class="link-card box bg-cyan" href={me.linkedin} target="_blank" rel="noopener"><b>LinkedIn</b><span>sushantkumar-vit</span></a>
              {me.fiverr
                ? <a class="link-card box bg-pink" href={me.fiverr} target="_blank" rel="noopener"><b>Fiverr</b><span>gigs</span></a>
                : <div class="link-card box soon"><b>Fiverr</b><span>coming soon</span></div>}
              {me.upwork
                ? <a class="link-card box bg-orange" href={me.upwork} target="_blank" rel="noopener"><b>Upwork</b><span>profile</span></a>
                : <div class="link-card box soon"><b>Upwork</b><span>coming soon</span></div>}
            </div>
          </div>
        </div>
      </section>

      <footer class="foot">
        <div class="wrap foot-in mono">
          <span>© {new Date().getFullYear()} {me.name}</span>
          <span>press <kbd>`</kbd> for a terminal · hit 🎨 to tag the wall</span>
        </div>
      </footer>
    </div>

    <Terminal />

    <script>
      import '../scripts/page.ts';
    </script>
  </body>
</html>

<style>
  /* ---------- nav ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: var(--border);
  }
  .nav-in {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 68px;
  }
  .logo {
    font: 400 1.25rem/1 var(--f-head);
    text-decoration: none;
    padding: 6px 10px;
    background: var(--black);
    color: var(--lime);
    transform: rotate(-3deg);
  }
  .nav nav { display: flex; gap: 4px; margin-left: 12px; }
  .nav nav a {
    padding: 6px 10px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    font-size: .9rem;
    border: 3px solid transparent;
  }
  .nav nav a:hover { border-color: var(--black); background: var(--yellow); color: var(--black); }
  .nav-actions { margin-left: auto; display: flex; gap: 10px; }
  .btn.small { padding: .55em .8em; font-size: .85rem; box-shadow: 3px 3px 0 var(--shade); }
  /* Show the icon for the theme you'd switch to. */
  [data-theme-toggle] .sun { display: none; }
  :global(:root[data-theme='dark']) [data-theme-toggle] .sun { display: inline; }
  :global(:root[data-theme='dark']) [data-theme-toggle] .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) [data-theme-toggle] .sun { display: inline; }
    :global(:root:not([data-theme='light'])) [data-theme-toggle] .moon { display: none; }
  }
  @media (max-width: 860px) { .nav nav { display: none; } }
  @media (max-width: 480px) { .nav-actions [data-open-terminal] { display: none; } }

  /* ---------- hero ---------- */
  .hero { padding: clamp(40px, 8vw, 90px) 0 70px; }
  .hero-badges { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .hero-badges .sticker { transform: rotate(var(--t)); }
  .hero-name {
    margin: 0;
    font: 400 clamp(4rem, 17vw, 13.5rem)/.86 var(--f-display);
    text-transform: uppercase;
    letter-spacing: -.01em;
  }
  .hero-name span { display: block; width: fit-content; }
  .hero-name .l1 {
    color: var(--pink);
    -webkit-text-stroke: 4px var(--black);
    paint-order: stroke fill;
    text-shadow: 8px 8px 0 var(--black), 14px 14px 0 var(--lime);
    transform: rotate(-2deg);
  }
  .hero-name .l2 {
    margin-left: clamp(20px, 8vw, 140px);
    color: var(--cyan);
    -webkit-text-stroke: 4px var(--black);
    paint-order: stroke fill;
    text-shadow: 8px 8px 0 var(--black), 14px 14px 0 var(--yellow);
    transform: rotate(1.5deg);
  }
  .hero-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
    margin-top: 40px;
    align-items: start;
  }
  .hero-tag {
    margin: 0;
    padding: 22px 24px;
    font: 700 clamp(1.3rem, 2.6vw, 1.9rem)/1.25 var(--f-body);
    transform: rotate(-1deg);
  }
  .status {
    padding: 16px 18px;
    font-size: .9rem;
    background: var(--black);
    color: var(--lime);
    box-shadow: 8px 8px 0 var(--pink);
  }
  .status b { color: var(--yellow); }
  .blink i { animation: blink 1s steps(1) infinite; font-style: normal; }
  @keyframes blink { 50% { opacity: 0; } }
  .dot {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px rgba(184, 255, 31, .3);
    animation: pulse 1.6s infinite;
  }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px rgba(184, 255, 31, 0); } }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }
  @media (max-width: 760px) { .hero-row { grid-template-columns: 1fr; } }

  /* ---------- ticker ---------- */
  .tape {
    overflow: hidden;
    border-block: var(--border);
    background: repeating-linear-gradient(-45deg, var(--yellow) 0 28px, var(--black) 28px 56px);
    transform: rotate(-1.5deg);
    margin-inline: -20px;
  }
  .tape-track {
    display: flex;
    width: max-content;
    gap: 28px;
    padding: 12px 0;
    animation: tape 40s linear infinite;
  }
  .tape span {
    font: 400 1.35rem/1 var(--f-head);
    padding: 6px 12px;
    background: var(--black);
    color: var(--yellow);
    white-space: nowrap;
  }
  @keyframes tape { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .tape-track { animation: none; } }

  /* ---------- services ---------- */
  .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px; }
  .svc {
    display: flex;
    flex-direction: column;
    padding: 20px;
    transform: rotate(var(--t));
    transition: transform .15s, box-shadow .15s;
  }
  .svc:hover { transform: rotate(0) translate(-4px, -4px); box-shadow: var(--shadow-lg); }
  .svc-top { display: flex; justify-content: space-between; font-size: .8rem; font-weight: 700; }
  .svc-top span:last-child { background: var(--black); color: var(--lime); padding: 2px 6px; }
  .svc h3 { margin: 14px 0 8px; font: 400 1.55rem/1.05 var(--f-head); }
  .svc p { margin: 0 0 12px; font-weight: 600; }
  .svc ul { margin: 0 0 18px; padding: 0; list-style: none; }
  .svc li { padding: 6px 0; border-top: 2px dashed var(--black); font-size: .95rem; }
  .svc li::before { content: '▸ '; }
  .svc-link {
    margin-top: auto;
    align-self: flex-start;
    font-weight: 700;
    text-decoration: none;
    background: var(--black);
    color: var(--cream);
    padding: 8px 12px;
  }
  .svc-link:hover { background: var(--cream); color: var(--black); outline: 3px solid var(--black); }

  /* ---------- projects ---------- */
  .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
  .proj {
    display: flex;
    flex-direction: column;
    padding: 0 0 18px;
    transform: rotate(var(--t));
    transition: transform .15s, box-shadow .15s;
  }
  .proj:hover { transform: rotate(0) scale(1.02); box-shadow: var(--shadow-lg); z-index: 2; }
  .proj-bar {
    display: flex;
    justify-content: space-between;
    padding: 8px 14px;
    border-bottom: var(--border);
    font-size: .8rem;
    font-weight: 700;
  }
  .proj h3 { margin: 16px 18px 6px; font: 400 2rem/1 var(--f-head); }
  .proj p { margin: 0 18px 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: auto 18px 0; }
  .chips span {
    font: 700 .75rem var(--f-mono);
    padding: 3px 7px;
    border: 2px solid var(--ink);
    background: var(--paper);
  }
  .proj-link { margin: 14px 18px 0; font-weight: 700; }

  /* ---------- oss ---------- */
  .oss { display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; align-items: start; }
  @media (max-width: 860px) { .oss { grid-template-columns: 1fr; } }
  .log { list-style: none; margin: 0; padding: 0; }
  .log li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    border-bottom: 3px solid var(--ink);
  }
  .log li:last-child { border-bottom: 0; }
  .log a, .log span { font-weight: 700; }
  .log-where { font-size: .8rem; opacity: .7; font-weight: 400; }
  .log-tag {
    font: 400 .8rem/1 var(--f-head);
    padding: 6px 8px;
    color: var(--black);
    border: 3px solid var(--black);
  }
  .t-filed { background: var(--pink); color: var(--cream); }
  .t-tested { background: var(--cyan); }
  .t-fixed { background: var(--lime); }
  .log-state { font-size: .8rem; text-transform: uppercase; }
  @media (max-width: 560px) { .log li { grid-template-columns: auto 1fr; } .log-state { display: none; } }
  .feed { background: var(--black); color: var(--cream); box-shadow: 8px 8px 0 var(--lime); }
  .feed-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 14px; font-size: .85rem; border-bottom: 3px solid var(--lime); color: var(--lime);
  }
  .feed-list { padding: 8px 14px 14px; }
  .muted { opacity: .65; }

  /* ---------- about ---------- */
  .about { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: center; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } }
  .about-card { position: relative; padding: 38px 28px 26px; transform: rotate(-1deg); }
  .about-card p { margin: 0; font-size: 1.2rem; font-weight: 600; }
  .about-stk { position: absolute; top: -18px; left: 20px; transform: rotate(-4deg); }
  .about-stats { display: grid; gap: 18px; }
  .stat { display: flex; align-items: baseline; gap: 14px; padding: 14px 18px; }
  .stat:nth-child(2) { transform: translateX(24px) rotate(1deg); }
  .stat b { font: 400 2.2rem/1 var(--f-head); }
  .stat span { font-weight: 700; }

  /* ---------- contact ---------- */
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: start; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  .issue { display: grid; gap: 16px; padding: 0 0 22px; }
  .issue > :not(.issue-head) { margin-inline: 22px; }
  .issue-head {
    display: flex; gap: 10px; align-items: center;
    padding: 12px 18px; background: var(--black); color: var(--lime); font-size: .9rem;
  }
  .issue label { display: grid; gap: 6px; font-weight: 700; text-transform: uppercase; font-size: .85rem; }
  .issue input, .issue select, .issue textarea {
    width: 100%;
    padding: 12px;
    font: 500 1rem var(--f-body);
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 0;
    text-transform: none;
  }
  .issue input:focus, .issue select:focus, .issue textarea:focus {
    outline: none; background: var(--white); box-shadow: 5px 5px 0 var(--pink);
  }
  .issue .btn { justify-self: start; }
  .small-print { margin-top: -6px; font-size: .8rem; }
  .links { display: grid; gap: 16px; }
  .link-card {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 16px 18px; text-decoration: none;
    transition: transform .12s, box-shadow .12s;
  }
  a.link-card:hover { transform: translate(-4px, -4px); box-shadow: var(--shadow-lg); }
  .link-card b { font: 400 1.3rem/1 var(--f-head); }
  .link-card span { font: 700 .85rem var(--f-mono); overflow-wrap: anywhere; text-align: right; }
  .link-card.soon { background: repeating-linear-gradient(45deg, var(--white) 0 12px, var(--paper) 12px 24px); opacity: .85; }

  /* ---------- footer ---------- */
  .foot { border-top: var(--border); background: var(--black); color: var(--lime); }
  .foot-in { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; padding: 22px 0; font-size: .85rem; }
  kbd { padding: 1px 6px; border: 2px solid var(--lime); }
</style>
